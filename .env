# CareConnect environment variables
# ── Database ──────────────────────────────────────────────
DB_USER=root
DB_PASSWORD=123456
DB_HOST=127.0.0.1
DB_NAME=careconnect

# ── JWT ───────────────────────────────────────────────────
SECRET_KEY=careconnect-secret-2025
JWT_SECRET_KEY=careconnect-jwt-2025

# ── Twilio Voice + SpeechRecognition ─────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Public URL for Twilio webhooks
# Local dev: use ngrok → ngrok http 5000 → copy the https URL
# Production: your actual domain
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok.io